<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:banner="@mipmap/ic_launcher"
        android:label="IvyPlayTV"
        tools:replace="android:label">

        <activity
            android:name="com.nuvio.app.MainActivity"
            android:banner="@mipmap/ic_launcher"
            android:label="IvyPlayTV"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.nuvio.app.launcher.AppIconDefault" tools:node="remove" />
        <activity android:name="com.nuvio.app.launcher.AppIconArcticBlue" tools:node="remove" />
        <activity android:name="com.nuvio.app.launcher.AppIconEmerald" tools:node="remove" />
        <activity android:name="com.nuvio.app.launcher.AppIconRoseGold" tools:node="remove" />
        <activity android:name="com.nuvio.app.launcher.AppIconCopper" tools:node="remove" />
        <activity android:name="com.nuvio.app.launcher.AppIconGraphite" tools:node="remove" />
    </application>

</manifest>
